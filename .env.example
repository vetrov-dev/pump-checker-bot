# Скопируйте этот файл в .env и заполните. .env никому не отправляйте.

# Токен бота от @BotFather (/newbot). Пусто = бот только собирает базу запусков, без Telegram.
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько. Даёт /stats, /grant, /refund.
ADMIN_IDS=
# Контакт для вопросов по оплате (Telegram требует /paysupport), например @your_username
SUPPORT_CONTACT=

# RPC для запросов. Публичный (пусто) не отдаёт список холдеров, поэтому в /check не будет блока «Холдеры».
# Нужен ключ провайдера с методом getTokenLargestAccounts: Helius, QuickNode, Alchemy и т.п.
RPC_URL=
# Websocket для потока сделок (слежка /watch, сливы девов). Пусто = публичный Solana (видит только часть сделок).
# Пример: wss://mainnet.helius-rpc.com/?api-key=ВАШ_КЛЮЧ
WS_URL=

# --- Тарифы ---
FREE_LOOKUPS_PER_DAY=5
FREE_WATCHES=1
PRO_LOOKUPS_PER_DAY=300
PRO_WATCHES=20
# Цена Pro в Telegram Stars (250 Stars ≈ $4–5 при покупке звёзд пользователем) и срок
PRO_PRICE_STARS=250
PRO_DAYS=30

# Путь к базе (относительно папки бота)
DB_PATH=data/bot.db
